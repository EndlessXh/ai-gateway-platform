# =============================================================================
# AI Gateway Platform (product layer) — secrets and local artefacts
# =============================================================================
# Real environment files. deploy/.env.example is the only one tracked.
deploy/.env
deploy/.env.dev
deploy/.env.prod
deploy/.env.*.local
!deploy/.env.example

# Database dumps. Backups contain live user data and credentials hashes.
deploy/backups/
*.dump
*.sql.gz

# TLS material. Never commit a private key or certificate.
deploy/nginx/certs/*
!deploy/nginx/certs/.gitkeep
*.pem
*.key
*.crt
*.pfx

# Local tool output
.platform-tmp/
artifacts/phase6a2-claude-code/
