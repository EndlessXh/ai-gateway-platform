# =============================================================================
# AI Gateway Platform — deployment environment template
# =============================================================================
# Copy to an environment-specific file that is NEVER committed:
#
#   Copy-Item deploy/.env.example deploy/.env.dev
#   pwsh ./scripts/new-secrets.ps1 -EnvFile deploy/.env.dev
#
# This file contains PLACEHOLDERS ONLY. It must never hold a real credential.
# `deploy/.env.dev`, `deploy/.env.prod` and `deploy/.env.*.local` are gitignored.
#
# NOTE: the upstream New API `.env.example` at the repository root is a
# reference list of every supported backend variable and is intentionally left
# untouched so it keeps merging cleanly from upstream. THIS file is the
# product's deployment template and is the one the Compose stacks read.
# =============================================================================

# ── Compose identity ─────────────────────────────────────────────────────────
# Keeps this stack's containers, network and volumes namespaced away from the
# pre-existing `new-api-dev` stack in ../new-api-infra. Do not reuse that name.
COMPOSE_PROJECT_NAME=ai-gateway-dev
TZ=Asia/Shanghai

# ── Host port bindings (loopback only) ───────────────────────────────────────
# 3000 is already taken by the new-api-infra baseline stack, so the platform
# uses 3001. Every binding below is 127.0.0.1-only; never change to 0.0.0.0.
PLATFORM_HTTP_HOST=127.0.0.1
PLATFORM_HTTP_PORT=3001

# Optional loopback debug ports for DB/cache clients (psql, RedisInsight...).
# Left disabled by default; enable with the `dbports` Compose profile.
PLATFORM_POSTGRES_HOST_PORT=5433
PLATFORM_REDIS_HOST_PORT=6380

# ── PostgreSQL 16 ────────────────────────────────────────────────────────────
POSTGRES_IMAGE=postgres
POSTGRES_TAG=16.8-alpine
POSTGRES_USER=aigw
POSTGRES_DB=aigw
# REPLACE — generate with ./scripts/new-secrets.ps1
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD

# ── Redis 7 ──────────────────────────────────────────────────────────────────
REDIS_IMAGE=redis
REDIS_TAG=7.4.2-alpine
# REPLACE — generate with ./scripts/new-secrets.ps1
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD
REDIS_MAXMEMORY=256mb

# ── New API application secrets ──────────────────────────────────────────────
# MUST be distinct from each other and from any other environment.
# CRYPTO_SECRET encrypts upstream channel keys at rest: changing it after
# channels exist makes every stored upstream key undecryptable. Treat as
# permanent for the lifetime of a database.
# REPLACE — generate with ./scripts/new-secrets.ps1
SESSION_SECRET=REPLACE_ME_SESSION_SECRET
CRYPTO_SECRET=REPLACE_ME_CRYPTO_SECRET

# ── Application runtime ──────────────────────────────────────────────────────
PLATFORM_BRAND_NAME=HYC AI
NODE_NAME=ai-gateway-dev-local
NODE_TYPE=master
GIN_MODE=release
DEBUG=false
ENABLE_PPROF=false
ERROR_LOG_ENABLED=false
TLS_INSECURE_SKIP_VERIFY=false
# Do not auto-create a root token on first boot; tokens are created explicitly.
GENERATE_DEFAULT_TOKEN=false
STREAMING_TIMEOUT=300
MEMORY_CACHE_ENABLED=true
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5

# ── Session / cookie hardening ───────────────────────────────────────────────
# Dev runs plain HTTP on loopback, so Secure cookies must stay off or login
# breaks. Production MUST set SESSION_COOKIE_SECURE=true and list every
# trusted HTTPS origin in SESSION_COOKIE_TRUSTED_URL (comma separated).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=

# Gin trusted reverse proxies. In dev nothing proxies the app, so use strict
# mode. In production set this to the Nginx container/subnet address only.
TRUSTED_PROXIES=none

# ── Rate limiting ────────────────────────────────────────────────────────────
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_WEB_RATE_LIMIT_ENABLE=true
CRITICAL_RATE_LIMIT_ENABLE=true

# ── Production-only edge settings (unused by compose.dev.yaml) ───────────────
# Public hostname terminated by Nginx. No trailing slash.
PLATFORM_PUBLIC_DOMAIN=gateway.example.invalid
# Paths inside deploy/nginx/certs (gitignored, never commit certificates).
PLATFORM_TLS_CERT=/etc/nginx/certs/fullchain.pem
PLATFORM_TLS_KEY=/etc/nginx/certs/privkey.pem
NGINX_IMAGE=nginx
NGINX_TAG=1.27-alpine
# Pinned application image for production. Never use `latest`.
PLATFORM_IMAGE=ai-gateway-platform
PLATFORM_TAG=v1.0.0-rc.22-platform.1

# ── Backup retention (scripts/backup-db.ps1) ─────────────────────────────────
BACKUP_RETENTION_DAYS=14

# ── Licence compliance (AGPL-3.0) ────────────────────────────────────────────
# This product is a modified version of New API (AGPL-3.0). Running it as a
# network service triggers AGPLv3 section 13: users must be offered the
# Corresponding Source of the version they are talking to.
#
# SOURCE_CODE_URL must point at a PUBLICLY REACHABLE location serving THIS
# modified source. Deliberately left empty here — shipping a plausible-looking
# but fake URL would be worse than an empty one, because it would pass a naive
# check while satisfying nothing.
#
# Empty is tolerated in development and is reported as a launch blocker.
# scripts/preflight-release.ps1 FAILS when this is empty, a placeholder, or
# not https, so a production deploy cannot proceed without it.
SOURCE_CODE_URL=

# Optional. A hosted copy of the licence and notices. LICENSE and NOTICE ship
# in the repository regardless, so this is convenience, not compliance.
LICENSE_NOTICE_URL=

# Upstream attribution is NOT configurable and has no environment variable.
# AGPLv3 section 7(b) requires it to be preserved, so it lives as constants in
# setting/platform/compliance.go where brand configuration cannot blank it:
#   UPSTREAM_PROJECT_NAME = "New API"
#   UPSTREAM_PROJECT_URL  = "https://github.com/QuantumNous/new-api"
# Do not add env vars to override these.

# ── Pricing status ───────────────────────────────────────────────────────────
# `provisional` = the configured model prices are development placeholders and
# must never charge a real customer (see docs/adr/0005-provisional-model-pricing.md).
# `approved`    = prices have been set deliberately by the business.
# preflight-release.ps1 FAILS on production while this is `provisional`.
PRICING_STATUS=provisional
